# Copy to .env for local/dev (emulator or LAN).
# Production builds load EXPO_PUBLIC_ASE_WIS_API_URL from .env.prod.

# Next.js WIS API base URL (include /api, no trailing slash)
# Dev example: http://10.0.2.2:3000/api
EXPO_PUBLIC_ASE_WIS_API_URL=

# Same Firebase project as ase-wms-web
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
