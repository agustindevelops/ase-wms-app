{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "App Dev",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.vscode/debug.py",
      "args": ["dev"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "App Build",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.vscode/debug.py",
      "args": ["build"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "App Push",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.vscode/debug.py",
      "args": ["push"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}
